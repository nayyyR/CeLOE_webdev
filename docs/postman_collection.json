{
  "info": {
    "name": "Celoe API",
    "description": "Multi-Role Ticketing System - Backend API Collection\n\nAuthentication: Bearer Token via {{token}} variable.\n\nSet the {{base_url}} variable to http://localhost:8000/api before using.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticket_id",
      "value": "1"
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "role_id",
      "value": "1"
    },
    {
      "key": "division_id",
      "value": "1"
    },
    {
      "key": "permission_id",
      "value": "1"
    }
  ],
  "item": [    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "User - Tickets",
      "item": [
        {
          "name": "List My Tickets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user/tickets?search=&status=&division_id=",
              "host": ["{{base_url}}"],
              "path": ["user", "tickets"],
              "query": [
                { "key": "search", "value": "", "description": "Filter by subject" },
                { "key": "status", "value": "", "description": "Filter by status" },
                { "key": "division_id", "value": "", "description": "Filter by division ID" }
              ]
            }
          }
        },
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "subject", "value": "Laptop tidak bisa menyala", "type": "text" },
                { "key": "description", "value": "Laptop tiba-tiba mati setelah update Windows.", "type": "text" },
                { "key": "target_division_id", "value": "2", "type": "text" },
                { "key": "attachments", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{base_url}}/user/tickets", "host": ["{{base_url}}"], "path": ["user", "tickets"] }
          }
        },
        {
          "name": "Get Ticket Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/user/tickets/{{ticket_id}}", "host": ["{{base_url}}"], "path": ["user", "tickets", "{{ticket_id}}"] }
          }
        },
        {
          "name": "Add Thread",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "body", "value": "Sudah diinstall, mohon dicek.", "type": "text" },
                { "key": "attachments", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{base_url}}/user/tickets/{{ticket_id}}/threads", "host": ["{{base_url}}"], "path": ["user", "tickets", "{{ticket_id}}", "threads"] }
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"closed\"\n}"
            },
            "url": { "raw": "{{base_url}}/user/tickets/{{ticket_id}}/status", "host": ["{{base_url}}"], "path": ["user", "tickets", "{{ticket_id}}", "status"] }
          }
        }
      ]
    },
